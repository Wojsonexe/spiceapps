{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=spiceauth.db"
  },
  "Jwt": {
    "Issuer": "http://localhost:5045",
    "Audience": "spiceapi",
    "AccessTokenLifetime": 900,
    "RefreshTokenLifetime": 604800,
    "MfaSecret": "twoj-losowy-sekret-minimum-32-znaki-tutaj!"
  },
  "App": {
    "BaseUrl": "http://localhost:5045",
    "FrontendUrl": "http://localhost:3002"
  },
  "Auth": {
    "InternalClientId": "spiceapi-internal"
  },
  "Internal": {
    "Secret": "CHANGE_ME_BEFORE_PRODUCTION_MIN_32_CHARS"
  },
  "Crypto": {
    "WorkFactor": 14
  },
  "Email": {
    "FromEmail": "noreply@spiceauth.local",
    "FromName": "SpiceAuth",
    "Provider": "Console",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true
    }
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "PasswordResetTokenExpiryHours": 1,
    "EmailVerificationTokenExpiryHours": 24
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/spiceauth-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}