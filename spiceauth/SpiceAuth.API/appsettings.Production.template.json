{
  "_comment": "PRODUCTION TEMPLATE — copy to appsettings.Production.json and fill every REPLACE_ME field. Never commit secrets.",

  "ConnectionStrings": {
    "DefaultConnection": "Host=REPLACE_ME;Port=5432;Database=spiceauth;Username=spiceauth;Password=REPLACE_ME;Ssl Mode=Require;Trust Server Certificate=false;Application Name=SpiceAuth;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100;Connection Lifetime=300;"
  },

  "Jwt": {
    "Issuer":              "https://REPLACE_ME_YOUR_DOMAIN",
    "Audience":            "spiceapi",
    "AccessTokenLifetime":  900,
    "RefreshTokenLifetime": 604800,
    "MfaSecret":           "REPLACE_ME_MIN_32_CHARS_RANDOM_SECRET"
  },

  "App": {
    "BaseUrl":    "https://REPLACE_ME_YOUR_DOMAIN",
    "FrontendUrl": "https://REPLACE_ME_FRONTEND_DOMAIN"
  },

  "Auth": {
    "InternalClientId": "spiceapi-internal"
  },

  "Internal": {
    "Secret": "REPLACE_ME_MIN_32_CHARS_DIFFERENT_FROM_JWT_SECRET"
  },

  "Crypto": {
    "WorkFactor": 14
  },

  "Discord": {
    "ClientId":     "REPLACE_ME",
    "ClientSecret": "REPLACE_ME"
  },

  "Email": {
    "FromEmail": "noreply@REPLACE_ME_YOUR_DOMAIN",
    "FromName":  "SpiceAuth",
    "Provider":  "Smtp",
    "Smtp": {
      "Host":      "REPLACE_ME",
      "Port":       587,
      "Username":  "REPLACE_ME",
      "Password":  "REPLACE_ME",
      "EnableSsl":  true
    }
  },

  "Security": {
    "MaxFailedLoginAttempts":          5,
    "LockoutDurationMinutes":         15,
    "PasswordResetTokenExpiryHours":   1,
    "EmailVerificationTokenExpiryHours": 24
  },

  "Cors": {
    "AllowedOrigins": [
      "https://REPLACE_ME_FRONTEND_DOMAIN"
    ]
  },

  "Swagger": {
    "Enabled": false
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft":                          "Error",
        "Microsoft.Hosting.Lifetime":         "Information",
        "System":                             "Error",
        "SpiceAuth":                          "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Logging": {
    "LogLevel": {
      "Default":       "Warning",
      "Microsoft":     "Error",
      "System":        "Error"
    }
  }
}
